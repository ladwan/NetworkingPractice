    - target: {fileID: 3546500521746408135, guid: 08df28c273d28684d997ef6ab88d6102, type: 3}
      propertyPath: m_text
      value: "Each turn lasts 25 seconds. When time runs out, your turn will automatically
        end.\nAny unconfirmed movements or abilities will be canceled, and any blinking
        AP will be refunded. The timer pauses during animations, whether you\u2019re
        moving or attacking. Time spent in animations does not count against your
        25 seconds, and your turn will not end until all confirmed, in-progress actions
        have finished."
      objectReference: {fileID: 0}
    - target: {fileID: 3546500521746408135, guid: 08df28c273d28684d997ef6ab88d6102, type: 3}
